# Supabase 連線資訊 (自架在 VPS 上的實例)
# 網頁版 (Next.js) 用 NEXT_PUBLIC_ 前綴的變數
NEXT_PUBLIC_SUPABASE_URL=https://your-vps-domain.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 小工具 (Electron / Vite) 用 VITE_ 前綴的變數
VITE_SUPABASE_URL=https://your-vps-domain.example.com
VITE_SUPABASE_ANON_KEY=your-anon-key
